# Docker Compose development configuration. Copy this file to .env in the project root.
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum_dev
POSTGRES_DB=museum
API_PORT=8002
# Leave empty to disable admin endpoints; generate a key with: openssl rand -hex 32
ADMIN_API_KEY=
# Browser origins as a JSON array. Flutter iOS/Android does not need CORS.
CORS_ORIGINS=[]
