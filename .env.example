# Docker Compose development configuration. Copy this file to .env in the project root.
POSTGRES_USER=museum
POSTGRES_PASSWORD=museum_dev
POSTGRES_DB=museum
API_PORT=8002
# Leave empty to disable admin endpoints; generate a key with: openssl rand -hex 32
ADMIN_API_KEY=
# Browser origins as a JSON array. Flutter iOS/Android does not need CORS.
CORS_ORIGINS=[]

# Gemini chỉ được gọi từ backend; để trống sẽ tắt hỏi đáp.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=

# DUT AI embedding/reranking; keep the key private.
DUT_AI_API_KEY=
DUT_AI_BASE_URL=https://textembedding.dutai.io.vn
